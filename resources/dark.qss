QWidget {
    font-size: 14px;
    background: #24272e;
    color: #eef0f4;
}

QLabel {
    background: transparent;
}

QLineEdit,
QComboBox {
    border: 1px solid #4a5060;
    border-radius: 6px;
    padding: 6px 8px;
    background: #30343d;
    selection-background-color: #2f80ed;
}

QLineEdit:focus,
QComboBox:focus {
    border-color: #6aa7ff;
}

QPushButton {
    background: #3b414d;
    border: 1px solid #596172;
    border-radius: 6px;
    padding: 7px 12px;
}

QPushButton:hover {
    background: #464d5a;
}

QPushButton:pressed {
    background: #313640;
}

QPushButton:disabled,
QLineEdit:disabled,
QTableWidget:disabled {
    color: #8f96a3;
    background: #2b2f37;
}

QTableWidget {
    gridline-color: #3d4350;
    background: #292d35;
    alternate-background-color: #30343d;
    selection-background-color: #345f8f;
    selection-color: #ffffff;
}

QHeaderView::section {
    background: #353b46;
    color: #f5f6f8;
    border: 0;
    border-right: 1px solid #454c59;
    padding: 7px;
}

QProgressBar {
    border: 1px solid #4a5060;
    border-radius: 6px;
    background: #30343d;
    text-align: center;
    min-height: 18px;
}

QProgressBar::chunk {
    border-radius: 5px;
    background-color: #2f80ed;
}

QCheckBox {
    background: transparent;
    spacing: 8px;
}
