/* 基础配色 */
QWidget {
    font-size: 14px;
    background: #2b2b2b;
    color: #e0e0e0;
}

/* 输入框 & 进度条 */
QLineEdit, QProgressBar {
    border: 1px solid #444;
    border-radius: 6px;
    padding: 4px 6px;
    background: #404040;
}

QProgressBar::chunk {
    border-radius: 6px;
    background-color: #00b894;          /* 青绿色进度块 */
}

/* 表格 */
QTableWidget {
    gridline-color: #555;
    selection-background-color: #34495e; /* 选中行蓝灰 */
    alternate-background-color: #333;
}
QHeaderView::section {
    background: #3c3c3c;
    border: 0;
    padding: 6px;
}

/* 按钮 – 默认 / Hover / 按下 */
QPushButton {
    background: #3c3c3c;
    border: 1px solid #555;
    border-radius: 8px;
    padding: 6px 12px;
}
QPushButton:hover { background: #505050; }
QPushButton:pressed { background: #2d2d2d; }
